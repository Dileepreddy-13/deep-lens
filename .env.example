# Deep Lens — Environment Configuration
# Copy to .env and configure values for your environment.
# Never place real secrets in this file.

# Application
APP_ENV=development
APP_NAME="Deep Lens"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-before-running

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_ENABLE_SIMULATION_MODE=true

# Database
# SQLite for local development; PostgreSQL/PostGIS for deployment.
DATABASE_URL=sqlite:///./deep_lens.db

# Optional background processing
REDIS_URL=redis://localhost:6379/0

# Global Fishing Watch
GFW_API_KEY=
GFW_API_BASE_URL=https://gateway.globalfishingwatch.org/v3

# Copernicus Data Space
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# NOAA Coral Reef Watch
NOAA_CRW_BASE_URL=https://coralreefwatch.noaa.gov/product/vs/data/

# Data ingestion
DEMO_DATA_SEED_ON_STARTUP=true
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=25